{
  "name": "local-project-manager",
  "version": "0.2.0",
  "description": "命令行：看本机在跑什么项目、占了哪些端口，扫描本机的 electron / tauri / web 项目",
  "type": "module",
  "author": "leeo",
  "private": true,
  "bin": {
    "lpm": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3"
  }
}
